# Antigravity ZeroLLMapi Bridge — Environment Configuration
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# NEVER commit a real `.env` to version control.
# ------------------------------------------------------------------

# 1. Google Gemini Pro Plan / Antigravity local session
# ZERO external paid APIs needed (no OpenAI, no Anthropic, no paid cloud bills).
# Automatically paired via 1-click Chrome onboarding portal (http://127.0.0.1:5000/setup)
GEMINI_AUTH_TOKEN=paste-your-gemini-session-token-here

# 2. Local bridge server settings (OpenAI-compatible endpoint)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5000
AGY_CLI_PATH=bin/agy.cmd

# 3. Local n8n connection
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=paste-your-n8n-api-key-here
